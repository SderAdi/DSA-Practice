#include <iostream>
using namespace std;
int main(){
    int arr[]= {4,1,1,1,2};
    int sz = sizeof(arr)/sizeof(arr[0]);
    int k = 5;
    int maxlen = 0;
    for (int i = 0; i < sz; i++){
         int sum = 0;

         for (int j = i; j < sz; j++){
            sum = sum+arr[j];

            if (sum == k){
             int length = j-i+1;
             if (length > maxlen){
                maxlen = length;
             }
            }
            
         }
    }
    cout << maxlen;
}
