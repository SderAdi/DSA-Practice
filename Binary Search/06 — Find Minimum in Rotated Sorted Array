#include <iostream>
using namespace std;
int main(){
        int arr[] = {3,1,2};
        int sz = sizeof(arr)/sizeof(arr[0]);
        int st = 0;
        int end = sz-1;
        while (st < end){
            int mid = st + (end - st)/2;
            if (arr[mid] > arr[end]){
                st = mid+1;
            }
            else {
                end = mid;
            }
        }
       cout << arr[st]; 
}
